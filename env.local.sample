# Copy to .env before running docker compose.
# Replace this JWT secret with a random value of at least 32 bytes.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRATION_DATE=900000
DB_PASSWORD=localdev
RABBITMQ_PASSWORD=localdev
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional monitoring account. Empty password keeps /actuator/prometheus and /actuator/info closed.
MONITORING_USERNAME=prometheus
MONITORING_PASSWORD=
DB_POOL_SIZE=15
DB_SCHEDULER_THREADS=2
DB_SCHEDULER_POLLING_INTERVAL=1s
OUTBOX_WORKERS=4
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=12
OUTBOX_CONFIRM_TIMEOUT=5s
OUTBOX_LEASE_DURATION=30s
OUTBOX_POLL_INTERVAL=1s
